# Dependency directories
node_modules/

# Python virtual environments
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# Logs and runtime artifacts
*.log
config/*.log

# Build artifacts (tracked separately via LFS)
dist/
build/
release/

# Webpack output (built from js/ via `npm run build`; hand-authored assets
# such as static/*.html, static/*.css, images and fonts are NOT matched here)
static/*.js
static/*.js.map
static/*.LICENSE.txt

# Runtime configuration containing secrets (see config/config.json.example
# for a sanitized template)
config/config.json
config/config.json.bak

# ⛔ Somebody's team photographs live here. They are runtime data, not source,
# and this repository is public — one stray "git add ." would publish faces.
# scripts/make-demo-portraits.py regenerates the placeholder set used for the
# README mockup, so nothing in here ever needs to be kept.
config/backgrounds/

# macOS metadata
.DS_Store
**/.DS_Store

# Local scratch area for files staged for deletion — never part of the source tree
_to_delete/
