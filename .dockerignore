# Installed inside the image by `npm install`; copying the host tree over the
# freshly installed one is how the --omit=dev bug used to stay hidden.
node_modules

# Build output — regenerated by `npm run build` in the frontend stage
static/*.js
static/*.js.map
static/*.LICENSE.txt
dist
build
release

# Not needed to build or run the image
.git
.github
.venv
__pycache__
*.pyc
docs
resources
scripts
vendor
electron-build.js
electron-builder.yml
main.js
Dockerfile
DockerfileArch
DockerfileArch.dockerignore
docker-compose.yaml
wirelessboard.service
CHANGELOG.md
README.md
LICENSE

# Runtime configuration and logs — never bake these into an image
config/config.json
*.log
